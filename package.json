{
  "name": "homie-rocks",
  "private": true,
  "description": "Homie's open core: the Homie plugin for Claude Code, Codex and Grok, @homie-rocks/studio, and the @homie-rocks game engine packages.",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/studio",
    "packages/arcade",
    "packages/audio",
    "packages/brush",
    "packages/bus",
    "packages/camera",
    "packages/device",
    "packages/diagnostics",
    "packages/film",
    "packages/fx",
    "packages/geom",
    "packages/heightfield",
    "packages/input",
    "packages/loop",
    "packages/noise",
    "packages/postfx",
    "packages/props",
    "packages/render",
    "packages/scatter",
    "packages/scores",
    "packages/ui",
    "packages/ui-world",
    "packages/walk"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --build",
    "test": "npm run build && node --test packages/*/test/*.test.mjs scripts/*.test.mjs",
    "test:plugin": "node --test plugins/homie/test/*.test.mjs",
    "test:rules:extended": "RULES_EXTENDED=1 node --test packages/studio/test/rules-corpus.test.mjs packages/studio/test/rules-protocol-corpus.test.mjs packages/studio/test/rules-author-requests.test.mjs packages/studio/test/rules-boundaries.test.mjs packages/studio/test/rules-repeatability.test.mjs packages/studio/test/rules-prediction-chrome.test.mjs packages/studio/test/rules-3d-prediction-chrome.test.mjs packages/studio/test/rules-interest.test.mjs packages/studio/test/rules-traffic-chrome.test.mjs packages/studio/test/rules-crowd-extended.mjs",
    "test:mod": "claude plugin test plugins/homie",
    "validate": "claude plugin validate . && claude plugin validate plugins/homie",
    "release:check": "node scripts/publish.mjs --check",
    "test:rooms:updates": "HOMIE_ROOMS_PAGE_SOAK=1 node --test packages/studio/test/rooms-pages.test.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@types/node": "22.20.1",
    "@types/three": "0.185.1",
    "miniflare": "5.20260930.0-alpha",
    "n8ao": "2.0.1",
    "postprocessing": "6.39.3",
    "simplex-noise": "4.0.3",
    "three": "0.185.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.5"
    }
  }
}
