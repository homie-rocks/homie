{
  "name": "@homie-rocks/ui",
  "version": "0.1.0",
  "description": "Screen-space UI primitives for games with no renderer dependency: cached DOM writes, readouts and menus, coalescing alerts, canvas gauges and instrument marks, Oklab colour with contrast audits, and a code-drawn font.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/homie-rocks/homie.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/homie-rocks/homie/tree/main/packages/ui#readme",
  "bugs": {
    "url": "https://github.com/homie-rocks/homie/issues"
  },
  "exports": {
    "./package.json": "./package.json",
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "src/**/*.ts",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc --build",
    "prepack": "tsc --build"
  }
}
