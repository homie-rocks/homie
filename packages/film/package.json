{
  "name": "@homie-rocks/film",
  "version": "0.1.0",
  "description": "Film production as data: a declarative shot timeline you can query at any time, a seek/reset contract, set volumes with continuity checks, dialogue and captions, and resumable capture plans. No renderer.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/homie-rocks/homie.git",
    "directory": "packages/film"
  },
  "homepage": "https://github.com/homie-rocks/homie/tree/main/packages/film#readme",
  "bugs": {
    "url": "https://github.com/homie-rocks/homie/issues"
  },
  "exports": {
    "./package.json": "./package.json",
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "src/**/*.ts",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc --build",
    "prepack": "tsc --build"
  },
  "dependencies": {
    "@homie-rocks/camera": "0.1.0"
  }
}
