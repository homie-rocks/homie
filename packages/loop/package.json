{
  "name": "@homie-rocks/loop",
  "version": "0.1.0",
  "description": "A browser frame loop for WebGL games: clamped timestep, an adaptive resolution ladder, a render-failure fallback, coalesced resize and context-loss recovery. It has no three.js dependency.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/homie-rocks/homie.git",
    "directory": "packages/loop"
  },
  "homepage": "https://github.com/homie-rocks/homie/tree/main/packages/loop#readme",
  "bugs": {
    "url": "https://github.com/homie-rocks/homie/issues"
  },
  "exports": {
    "./package.json": "./package.json",
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "src/**/*.ts",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc --build",
    "prepack": "tsc --build"
  },
  "dependencies": {
    "@homie-rocks/device": "0.1.0"
  }
}
