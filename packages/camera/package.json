{
  "name": "@homie-rocks/camera",
  "version": "0.1.0",
  "description": "Camera maths for three.js games: closed-form springs, lens and field-of-view fitting, an exact frame solver, and chase-rig and cinematic building blocks. Every tuning number is the caller's; none has a default.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/homie-rocks/homie.git",
    "directory": "packages/camera"
  },
  "homepage": "https://github.com/homie-rocks/homie/tree/main/packages/camera#readme",
  "bugs": {
    "url": "https://github.com/homie-rocks/homie/issues"
  },
  "exports": {
    "./package.json": "./package.json",
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "src/**/*.ts",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc --build",
    "prepack": "tsc --build"
  },
  "peerDependencies": {
    "three": "0.185.1"
  },
  "devDependencies": {
    "three": "0.185.1"
  }
}
