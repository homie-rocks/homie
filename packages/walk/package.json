{
  "name": "@homie-rocks/walk",
  "version": "0.1.1",
  "description": "On-foot movement for three.js games: a walker with ground-contact hysteresis, coyote time, jump buffering, slope limits and step height, plus a gait clock, foot planting and a GPU-posed biped.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/homie-rocks/homie.git",
    "directory": "packages/walk"
  },
  "homepage": "https://github.com/homie-rocks/homie/tree/main/packages/walk#readme",
  "bugs": {
    "url": "https://github.com/homie-rocks/homie/issues"
  },
  "exports": {
    "./package.json": "./package.json",
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "src/**/*.ts",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc --build",
    "prepack": "tsc --build"
  },
  "dependencies": {
    "@homie-rocks/camera": "0.2.0"
  },
  "peerDependencies": {
    "three": "0.185.1"
  }
}
