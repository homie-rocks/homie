{
  "name": "@homie-rocks/heightfield",
  "version": "0.2.0",
  "description": "A regular grid of heights and the questions asked of one: bilinear fetch, normals and slope, band-limiting filters, a horizon bake for sky view, and skirted chunk meshes. Pure arithmetic; imports nothing.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/homie-rocks/homie.git",
    "directory": "packages/heightfield"
  },
  "homepage": "https://github.com/homie-rocks/homie/tree/main/packages/heightfield#readme",
  "bugs": {
    "url": "https://github.com/homie-rocks/homie/issues"
  },
  "exports": {
    "./package.json": "./package.json",
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "src/**/*.ts",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc --build",
    "prepack": "tsc --build"
  }
}
