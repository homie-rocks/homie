  },
  "devDependencies": {
    "three": "0.185.1",
    "postprocessing": "6.39.3",
    "simplex-noise": "^4.0.3",
    "@homie-rocks/geom": "0.1.1",
    "@homie-rocks/noise": "0.1.0"
  }
