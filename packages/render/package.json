  "description": "Rendering building blocks for three.js games: GPU capability probing and quality tiers, texture budget and shader pre-warm, cascaded shadows, draw-call and light budgets, and procedural texture bakers.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/homie-rocks/homie.git",
