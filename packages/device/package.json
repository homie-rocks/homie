{
  "name": "@homie-rocks/device",
  "version": "0.1.0",
  "description": "Device classification that survives iPadOS desktop mode, crash-proof per-field validation of stored preferences, and the measured maths and state machine for an on-screen thumb stick.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/homie-rocks/homie.git",
    "directory": "packages/device"
  },
  "homepage": "https://github.com/homie-rocks/homie/tree/main/packages/device#readme",
  "bugs": {
    "url": "https://github.com/homie-rocks/homie/issues"
  },
  "exports": {
    "./package.json": "./package.json",
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "src/**/*.ts",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc --build",
    "prepack": "tsc --build"
  }
}
