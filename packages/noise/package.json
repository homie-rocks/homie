{
  "name": "@homie-rocks/noise",
  "version": "0.1.0",
  "description": "Seeded procedural noise and scalar fields on the CPU: simplex, value and gradient noise, seamlessly tiling fbm, ridged and turbulence fields, voronoi, brick, strata and panel layouts, and surface detail presets.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/homie-rocks/homie.git",
    "directory": "packages/noise"
  },
  "homepage": "https://github.com/homie-rocks/homie/tree/main/packages/noise#readme",
  "bugs": {
    "url": "https://github.com/homie-rocks/homie/issues"
  },
  "exports": {
    "./package.json": "./package.json",
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "src/**/*.ts",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc --build",
    "prepack": "tsc --build"
  },
  "peerDependencies": {
    "simplex-noise": "^4.0.3"
  }
}
