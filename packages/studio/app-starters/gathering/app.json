          "status": {
            "type": "string",
            "required": true,
            "maxLength": 60
          },
          "amount": {
            "type": "number",
            "required": true
          },
          "monthly": {
            "type": "boolean",
            "required": true
          }
        }
      }
    }
  },
  "parts": [],
  "netplay": {
    "v": 1,
    "public": true,
    "version": "1",
    "params": [
      "role",
      "surface",
      "ticket"
    ]
  },
  "playerCard": false,
  "chat": false,
  "agents": {
    "vote": false
  },
  "watch": "overview",
  "screen": {
    "join": "bottom-right",
    "share": "top-right"
  },
  "needs": {
    "three": "0.185.1",
    "@homie-rocks/camera": "0.2.1",
    "@homie-rocks/geom": "0.1.1",
    "@types/three": "0.185.1"
  },
  "check": {
    "action": "[data-action]",
    "observe": "[data-count]"
