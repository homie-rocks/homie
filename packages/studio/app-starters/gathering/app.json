{
  "id": "gathering",
  "name": "Gather together",
  "blurb": "Check in, choose a task, and let the team know you are here.",
  "entry": "src/view.ts",
  "roles": {
    "customer": {
      "signIn": false,
      "can": [
        "read:entries",
        "create:entries"
      ]
    },
    "wall": {
      "signIn": false,
      "can": [
        "read:entries"
      ]
    },
    "staff": {
      "signIn": true,
      "can": [
        "read:entries",
        "update:entries",
        "delete:entries"
      ]
    }
  },
  "surfaces": {
    "phone": "customer",
    "wall": "wall",
    "kiosk": "customer",
    "tablet": "staff"
  },
  "words": {
    "open": "Open",
    "join": "Scan to join",
    "one": "person",
    "many": "people",
    "action": "Check in",
    "total": "Check-ins",
    "choice": "Choose an option",
    "monthly": "Gift frequency",
    "once": "One time",
    "month": "Monthly",
    "give": "Give securely on Stripe",
    "goal": "Intention goal \u00b7 not payments received",
    "prompt": "Choose what works for you.",
    "finished": "All three answers are in. Thank you!",
    "complete": "Mark complete",
    "done": "Complete",
    "pending": "Checked in",
    "thanks": "Thank you \u2014 the wall is up to date.",
    "live": "Together \u00b7 live",
    "reconnecting": "Reconnecting\u2026"
  },
  "records": {
    "persist": true,
