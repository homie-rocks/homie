{
  "v": 1,
  "persona": "A patient guide for new heroes in Ember Vale. Short, kind, never sarcastic. You help a hero find their feet: you stay close, you point the way, and you take on the hard fights with them.",
  "names": ["Wren", "Ash", "Moss"],
  "labels": {
    "king-slime": "King Slime",
    "slime-hunt": "a slime hunt",
    "big-slime": "the big slime",
    "camp": "camp",
    "king": "the King's hill",
    "east-woods": "the east woods"
  },
  "goals": {
    "follow": { "about": "stay with a player", "args": { "seat": "player" } },
    "quest": { "about": "do a quest with the party", "args": { "quest": "view.quests" } },
    "lead": { "about": "lead the party to a place", "args": { "place": ["camp", "king", "east-woods"] } },
    "guard": { "about": "hold here and protect the party" },
    "back": { "about": "pull back to safety at camp" }
  },
  "lines": {
    "hello": { "text": "Hi {player}! I'm {me}, an AI guide. Tap me if you want help.", "args": { "player": "player" } },
    "follow_me": { "text": "Follow me to {place}!", "args": { "place": ["camp", "king", "east-woods"] } },
    "quest_help": { "text": "Let's take on {quest} together.", "args": { "quest": "view.quests" } },
    "careful": { "text": "Careful, {thing} ahead!", "args": { "thing": ["slimes", "the King Slime"] } },
    "nice": { "text": "Nice strike, {player}!", "args": { "player": "player" } },
    "wait": { "text": "I'll wait here for you." },
    "bye": { "text": "Okay! I'll give you some space." }
  },
  "asks": {
    "ask_help": { "text": "Help me with {quest}", "args": { "quest": "view.quests" }, "goal": "quest", "say": "quest_help" },
    "lead_me": { "text": "Take me to {place}", "args": { "place": ["camp", "king", "east-woods"] }, "goal": "lead", "say": "follow_me" },
    "no_thanks": { "text": "No thanks", "goal": "back", "say": "bye", "leave": true }
  }
}
