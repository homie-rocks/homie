{
  "name": "@homie-rocks/studio",
  "version": "0.58.29",
  "description": "Open-source tools that let your AI build and run a multiplayer game studio on its own Cloudflare: an MCP server, multiplayer starters, Workers and Durable Objects.",
  "type": "module",
  "license": "Apache-2.0",
  "homepage": "https://homie.rocks/make/studio/",
  "keywords": [
    "mcp",
    "mcp-server",
    "ai-agents",
    "multiplayer",
    "multiplayer-games",
    "game-studio",
    "game-engine",
    "cloudflare-workers",
    "durable-objects",
    "cloudflare",
    "netplay",
    "open-source"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/homie-rocks/homie.git",
    "directory": "packages/studio"
  },
  "bin": {
    "homie-studio": "bin/homie-studio.mjs"
  },
  "exports": {
    "./netplay": {
      "types": "./netplay/netplay.ts",
      "default": "./netplay/netplay.ts"
    },
    "./port": {
      "types": "./port/index.ts",
      "default": "./port/index.ts"
    },
    "./port/early": {
      "types": "./port/early.ts",
      "default": "./port/early.ts"
    },
    "./saves": {
      "types": "./saves/saves.ts",
      "default": "./saves/saves.ts"
    },
    "./shop": {
      "types": "./shop/shop.ts",
      "default": "./shop/shop.ts"
    },
    "./agents": {
      "types": "./agents/agents.ts",
      "default": "./agents/agents.ts"
    },
    "./lab": {
      "types": "./lab/lab.ts",
      "default": "./lab/lab.ts"
    },
    "./assets": {
      "types": "./assets/assets.ts",
      "default": "./assets/assets.ts"
    },
    "./animate": {
      "types": "./assets/animate.ts",
      "default": "./assets/animate.ts"
    },
    "./personas": {
      "types": "./port/personas.ts",
      "default": "./port/personas.ts"
    },
    "./powerups": {
      "types": "./port/powerups.ts",
      "default": "./port/powerups.ts"
    },
    "./rules": {
      "types": "./rules/rules.ts",
      "default": "./rules/rules.ts"
    },
    "./rules/view": {
      "types": "./rules/view.ts",
      "default": "./rules/view.ts"
    },
    "./rules/guard": {
      "types": "./rules/guard.ts",
      "default": "./rules/guard.ts"
    },
    "./rules/host": {
      "types": "./rules/host.ts",
      "default": "./rules/host.ts"
    },
    "./worker": "./worker/index.mjs",
    "./package.json": "./package.json",
    "./links": {
      "types": "./links/links.d.ts",
      "default": "./links/links.mjs"
    },
    "./apps": {
      "types": "./apps/apps.ts",
      "default": "./apps/apps.ts"
    },
    "./worker/selling": "./worker/selling/index.mjs",
    "./worker/schedule": {
      "types": "./worker/function-schedule.d.ts",
      "default": "./worker/function-schedule.mjs"
    },
    "./tools": {
      "types": "./tools/tools.ts",
      "default": "./tools/tools.ts"
    },
    "./functions": {
      "types": "./functions/functions.ts",
      "default": "./functions/functions.ts"
    },
    "./rules/physics-engine": "./rules/physics-engine.ts"
  },
  "files": [
    "docs/",
    "bin/",
    "lib/",
    "netplay/",
    "port/",
    "rules/",
    "worker/",
    "mcp/",
    "saves/",
    "shop/",
    "agents/",
    "lab/",
    "assets/",
    "starters/",
    "media/",
    "site/",
    "chat/",
    "parts/",
    "standalone/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "links/",
    "apps/",
    "app-starters/",
    "tools/",
    "functions/",
    "guides/"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@babel/generator": "8.0.6",
    "@babel/parser": "8.0.7",
    "@babel/traverse": "8.0.7",
    "@babel/types": "8.0.6",
    "@cloudflare/workers-oauth-provider": "1.2.3",
    "@coinbase/x402": "2.1.0",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@jridgewell/trace-mapping": "0.3.31",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@x402/core": "2.28.0",
    "@x402/evm": "2.28.0",
    "agents": "0.28.1",
    "esbuild": "0.28.1",
    "gltf-validator": "2.0.0-dev.3.10",
    "jose": "6.2.12",
    "mcp-purchase-sdk": "npm:@modelcontextprotocol/sdk@1.32.1",
    "mcp-studio-client": "npm:@modelcontextprotocol/client@2.3.1",
    "meshoptimizer": "1.3.0",
    "mppx": "0.13.2",
    "puppeteer-core": "25.8.0",
    "sharp": "0.35.5",
    "spdx-expression-parse": "5.0.0",
    "stripe": "23.0.0",
    "three": "0.185.1",
    "typescript": "5.9.3",
    "viem": "2.57.4",
    "ws": "8.22.0",
    "zod": "4.3.6"
  },
  "scripts": {
    "pretest": "tsc --build ../../tsconfig.json",
    "test": "node --test --test-concurrency=2 --test-timeout=1800000 test/*.test.mjs",
    "prepack": "node lib/build-identity.mjs --check && node ../../scripts/authoring-guides.mjs --check && node ../../scripts/studio-template-history.mjs --check"
  },
  "peerDependencies": {
    "@homie-rocks/physics": "0.1.3"
  },
  "peerDependenciesMeta": {
    "@homie-rocks/physics": {
      "optional": true
    }
  }
}
