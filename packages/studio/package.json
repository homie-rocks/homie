{
  "name": "@homie-rocks/studio",
  "version": "0.31.1",
  "description": "A studio for games, music and video on its own Cloudflare: scaffold, multiplayer starters on the netplay contract, a port toolkit that makes existing single-player web games multiplayer, the site Worker with public rooms (Table/Lobby Durable Objects and D1, all on the free Workers plan, no payment method), a site with the hub's sections (Home, Games, Music, Videos, Rooms, Posts with feeds) in the studio's own look, an epic landing page for every game, big songs and videos in the studio's own R2 once it has storage (uploaded, checked by SHA-256, served at the same addresses), deploy, and the homie.rocks directory.",
  "type": "module",
  "license": "Apache-2.0",
  "homepage": "https://homie.rocks/studio/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/homie-rocks/homie.git",
    "directory": "packages/studio"
  },
  "bin": {
    "homie-studio": "bin/homie-studio.mjs"
  },
  "exports": {
    "./netplay": {
      "types": "./netplay/netplay.ts",
      "default": "./netplay/netplay.ts"
    },
    "./port": {
      "types": "./port/index.ts",
      "default": "./port/index.ts"
    },
    "./port/early": {
      "types": "./port/early.ts",
      "default": "./port/early.ts"
    },
    "./saves": {
      "types": "./saves/saves.ts",
      "default": "./saves/saves.ts"
    },
    "./shop": {
      "types": "./shop/shop.ts",
      "default": "./shop/shop.ts"
    },
    "./agents": {
      "types": "./agents/agents.ts",
      "default": "./agents/agents.ts"
    },
    "./lab": {
      "types": "./lab/lab.ts",
      "default": "./lab/lab.ts"
    },
    "./assets": {
      "types": "./assets/assets.ts",
      "default": "./assets/assets.ts"
    },
    "./animate": {
      "types": "./assets/animate.ts",
      "default": "./assets/animate.ts"
    },
    "./personas": {
      "types": "./port/personas.ts",
      "default": "./port/personas.ts"
    },
    "./powerups": {
      "types": "./port/powerups.ts",
      "default": "./port/powerups.ts"
    },
    "./worker": "./worker/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "bin/",
    "lib/",
    "netplay/",
    "port/",
    "worker/",
    "mcp/",
    "saves/",
    "shop/",
    "agents/",
    "lab/",
    "assets/",
    "starters/",
    "media/",
    "site/",
    "chat/",
    "parts/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "esbuild": "0.28.1",
    "gltf-validator": "2.0.0-dev.3.10",
    "meshoptimizer": "1.3.0",
    "puppeteer-core": "25.8.0",
    "sharp": "0.35.5",
    "three": "0.185.1"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  }
}
