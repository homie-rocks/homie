 assert.equal((await records('slots')).records.length,0,'Fresh archived-database proof');await shot(wall.page,'wall-empty');
 for(const [id,label] of [[source,'Sat Oct 17 · 9:00 AM'],[target,'Sat Oct 17 · 10:00 AM']]){const f=await frame(staff.page);await f."'$eval('"'#slot-id',(e,v)=>e.value=v,id);await f."'$eval('"'#slot-label',(e,v)=>e.value=v,label);await f.click('#publish-slot');await until(async()=> (await records('slots')).records.some(r=>r.id===id),'published slot');}
 proof('Staff published fresh slots through UI');await shot(staff.page,'staff-published');
 const manifest=(await records('slots')).records.map(r=>({app:'tune',collection:'bookings',slots:'slots',slot:r.id,item:'full-tune',capacity:r.data.capacity}));fs.writeFileSync(root+'/.studio/booking-slots.json',JSON.stringify(manifest,null,2));
 helper=await startKeylessStripeSandbox({origin,profile:'Homie sandbox',shop:JSON.parse(fs.readFileSync(root+'/shop.json')),bookingSlots:manifest,name:report.name});await restart();
 const initial=await providerSlots();assert(initial.every(s=>s.limit===1&&s.active));proof('Initial links have capacity-one completed-session limits; base64 bindings written verbatim',{slots:initial,mode:'links',apiKey:[REDACTED_SECRET]
