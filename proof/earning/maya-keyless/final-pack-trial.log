async function providerSlots(){const result=[];for(const s of helper.links.slots){const link=await helper.call('"'GET','/v1/payment_links/'+s.id);assert.equal(link.livemode,false);result.push({slot:s.slot,id:link.id,active:link.active,completed:link.restrictions?.completed_sessions?.count||0,limit:link.restrictions?.completed_sessions?.limit});}return result;}
