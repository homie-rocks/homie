function writeBindings(){const b=helper.bindings;assert.equal(b.STRIPE_CHECKOUT_MODE,'links');assert("'!('"'STRIPE_KEY'in b));assert("'!('"'STRIPE_API_BASE'in b));assert(b.STRIPE_SHOP_LINKS.startsWith('base64:'));for(const name of ['.dev.vars','.wrangler/.dev.vars']){fs.mkdirSync(root+'/.wrangler',{recursive:true});fs.writeFileSync(root+'/'+name,Object.entries(b).map(([k,v])=>"'`${k}=${v}`).join('"'\\n'),{mode:0o600});fs.chmodSync(root+'/'+name,0o600);}}
async function startDev(){const log=fs.openSync(E+"'`dev-${restartCount++}.log`,'"'w');dev=spawn(process.execPath,[cli,'dev','--port','8917','--no-local-ai'],{cwd:root,stdio:['ignore',log,log]});fs.closeSync(log);await until(async()=> (await fetch(origin+'/api/games',{signal:AbortSignal.timeout(3000)})).ok,'dev ready',90000);await delay(2500);}
async function restart(){await stopDev();writeBindings();await startDev();if(browser){await staff.context.close();staff=await open('staff',1100,900);for(const p of [phone.page,wall.page]){await p.reload({waitUntil:'domcontentloaded'});await frame(p);}}}
async function frame(p){return until(async()=>{const f=p.frames().find(f=>f.url().includes('/__game/'));return f&&await f."'$('"'#connection')?f:null;},'app frame');}
async function open(role,w=390,h=844,ticket=''){const context=await browser.createBrowserContext();if(role==='staff')await context.setCookie({name:'homie_test',value:localCookie(localCredential(root,origin),{app:'tune',role}),url:origin,httpOnly:true,sameSite:'Strict'});const page=await context.newPage();await page.setViewport({width:w,height:h,isMobile:role"'!=='"'wall',hasTouch:role"'!=='"'wall'});await page.goto("'`${origin}/tune/${role==='"'wall'?'tv':'open'}?role="'${role}&surface=${role==='"'staff'?'tablet':role==='wall'?'wall':'phone'}"'${ticket?'"'&ticket='+ticket:''}"'`,{waitUntil:'"'domcontentloaded'});await frame(page);return {page,context};}
async function shot(p,name){await p.bringToFront();await delay(400);await p.screenshot({path:E+name+'.png',fullPage:true});}
async function api(p,path,method='GET',body){return p.evaluate(async({path,method,body})=>{const r=await fetch(path,{method,headers:{'content-type':'application/json'},body:body?JSON.stringify(body):undefined});return {http:r.status,...await r.json()};},{path,method,body});}
const records=(collection,asStaff=false)=>api(asStaff?staff.page:phone.page,"'`/tune/api/app/records/${collection}${asStaff?'"'?role=staff':''}"'`);
async function readBooking(id){return (await records('"'bookings')).records.find(r=>r.id===id);}
async function book(slot,customer){await customer.page.bringToFront();const f=await frame(customer.page);await until(()=>f."'$eval(`[data-slot="${slot}"]`,e=>!e.disabled),'"'enabled book button');let result;const handler=async r=>{if(r.url().endsWith('/api/shop/buy'))try{result=await r.json();}catch{}};customer.page.on('response',handler);const popup=new Promise(resolve=>customer.page.once('popup',resolve));await f.click("'`[data-slot="${slot}"]`);const checkout=await Promise.race([popup,delay(20000).then(()=>{throw Error('"'Checkout popup absent');})]);await until(()=>result?.booking,'booking result');customer.page.off('response',handler);await until(()=>checkout.url().includes('buy.stripe.com'),'actual Stripe link');await checkout.setViewport({width:390,height:844,isMobile:true,hasTouch:true});return {...result,checkout};}
async function sessionFor(b,slot){const link=helper.links.slots.find(s=>s.slot===slot);return until(async()=>{const list=await helper.call('GET','/v1/checkout/sessions',{payment_link:link.id,limit:100});return list.data.find(s=>s.client_reference_id===b.order);},'session correlated to local order');}
