async function until(fn,label='condition',ms=60000){let error;const start=Date.now();while(Date.now()-start<ms){try{const r=await fn();if(r)return r;}catch(e){error=e;}await delay(500);}throw Error(label+': '+(error?.message||'timed out'));}
