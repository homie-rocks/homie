// This studio's site on its own Cloudflare account (written by homie-studio). Everything here runs on
// the studio's Cloudflare Workers account. `npm run deploy` (on this computer, or in Workers Builds) puts it live;
// `npx wrangler preview` puts a branch on its own Preview URL with its own rooms. There is no R2 binding
// until `homie-studio storage add` gives the studio storage for large media.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-studio",
  "main": "site/src/runtime/worker.js",
  "compatibility_date": "2026-06-01",
  "no_bundle": true,
  "find_additional_modules": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": [
        "**/*.js"
      ],
      "fallthrough": true
    }
  ],
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public",
    "disallow_eval_during_startup"
  ],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./site/dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "TABLE",
        "class_name": "Table"
      },
      {
        "name": "LOBBY",
        "class_name": "Lobby"
      },
      {
        "name": "GATE",
        "class_name": "Gate"
      },
      {
        "name": "CONCENTRATOR",
        "class_name": "Concentrator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Table",
        "Lobby"
      ]
    },
    {
      "tag": "v2-gates",
      "new_sqlite_classes": [
        "Gate",
        "Concentrator"
      ]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "my-studio-db",
      "migrations_dir": "site/migrations"
    }
  ],
  "vars": {
    "STUDIO_NAME": "My Studio"
  },
  "observability": {
    "enabled": true
  },
  "previews": {
    "vars": {
      "STUDIO_NAME": "My Studio",
      "HOMIE_PREVIEW": "1"
    },
    "durable_objects": {
      "bindings": [
        {
          "name": "TABLE",
          "class_name": "Table"
        },
        {
          "name": "LOBBY",
          "class_name": "Lobby"
        },
        {
          "name": "GATE",
          "class_name": "Gate"
        },
        {
          "name": "CONCENTRATOR",
          "class_name": "Concentrator"
        }
      ]
    }
  }
}
